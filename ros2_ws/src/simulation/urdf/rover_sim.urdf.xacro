<?xml version="1.0"?>
<!-- The rover as Gazebo sees it: the plain description plus the Gazebo-only parts.
     Both included files are generated by tools/rover_cad/build_urdf.py. -->
<robot name="urc_rover_v5" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find rover_description)/urdf/rover.urdf"/>
  <xacro:include filename="$(find simulation)/urdf/rover_gazebo.xacro"/>
</robot>
